Y',embed_textures=True)
+    bpy.ops.wm.save_as_mainfile(filepath=str(O/f"female-{row['name']}.blend"))
+    baseline.update(name=row['name'],gender=row['gender'],source=str(src.relative_to(R)),source_sha256=sha(src),fbx_sh
a256=sha(O/(row['name']+'.fbx')),materials=['Skin','Suit','Hair','Eyes','Brows'],skin_faces=sum(p.material_index==0 
