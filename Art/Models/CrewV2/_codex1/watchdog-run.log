+ eyes.save(O/f'female-{name}-eyes.png')
+ row['sampling']={'portrait':f'Assets/Art/UI/Portraits/art108-{name}.png','contactSkinXY':sk,'contactHairXY':ha,'metho
d':'median 5x5 pixels of portrait contact, sRGB; eyes dark iris interpretation preserving source sclera'}
+ rows.append(row)
