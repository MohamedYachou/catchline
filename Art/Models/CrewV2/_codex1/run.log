def coat_surface(x, z, lift=.0025):
    for a, b in zip(rows, rows[1:]):
        if a[0] <= z <= b[0]:
            t = (z-a[0])/(b[0]-a[0])
            rx, ry = (a[i]*(1-t)+b[i]*t for i in (1, 2))
            return (x, -ry*math.sqrt(max(.01, 1-(x/rx)**2))-lift, z)
    return (x, -.052-lift, z)


