def disk(g, c, radius, depth, mat, bone, seg=24):
    # Front-facing disc axis -Y; sweep uses a stable cross section.
    g.sweep([(c[0], c[1]+depth/2, c[2]), (c[0], c[1]-depth/2, c[2])],
            radius, mat, bone, seg, up=(0, 0, 1))


