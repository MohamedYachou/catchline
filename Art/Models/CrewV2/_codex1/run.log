        props.sweep([a-d, a+d], .028 if t > .5 else .023,
                    'M_BrassMira' if t == .78 else 'M_VisorMira', 'Spine1', 20)
    d = (p1-p0).normalized()
    props.sweep([p1+d*.004, p1+d*.006], .0225, 'M_LensMira', 'Spine1', 24)
