                coastalUi.Art("market/crate", new Rect(12, catalogY + 9, 80, 70), "icon-fish", catalog);
                coastalUi.Label("market/value", new Rect(104, catalogY + 8, catalogWidth * .4f, 66), $"{quote.Coins + 
quote.ContractCoins} coins\nReady to collect", 22, null, TextAnchor.MiddleLeft, catalog);
                coastalUi.Button("market/sell", new Rect(catalogWidth - 180, catalogY + 20, 164, 48), "Sell haul", () 
=> SellHaul(), "button-primary-normal", true, catalog);
                catalogY += 108;
            }
            else CatalogHeading("market/welcome", State.LastSale == null ? "Your first good day's fishing" : "Catch 
sold. Boat ready.", State.LastSale == null ? "Bring home three fish, sell them here, then choose your first 
improvement." : $"Last haul: {State.LastSale.FishSold} fish ├é┬À {State.LastSale.Coins + State.LastSale.ContractCoins} 
coins earned.", 93);
            CatalogHeading("market/log", $"Fish log ├é┬À {State.LogCount.Count(n => n > 0)}/{GameData.Fish.Length}", 
"Your records and today's market prices. Prices recover between voyages.", 82);
            for (int i = 0; i < GameData.Fish.Length; i++)
