        bool StartCompactNet(Person person, bool haul)
        {
            if (CurrentMode != Mode.Fishing || !AtFishingGround || !person.Idle || person.Carrying != null || 
netWorker != null)
                return false;
            if (Net != (haul ? NetState.Ready : NetState.Stowed)) return false;
            if (!haul && AvailableNetStock(0) <= 0) return false;
            if (RigBasketBlocked(0) || (!haul && HoldFull)) return false;
            netWorker = person;
            int claim = ++netClaim;
            Net = haul ? NetState.Hauling : NetState.Setting;
            bool Owns() => netClaim == claim && netWorker == person;
            void Cancel()
            {
                if (!Owns()) return;
                netWorker = null;
                netClaim++;
                Net = haul ? NetState.Ready : NetState.Stowed;
            }
            void Complete()
            {
                if (!Owns()) return;
                // One roll per full worker recovery, never one roll per stage.
                if (haul && !IsTier5 && !person.IsCaptain && State.Rng.NextDouble() >= .8) { Tear(); return; }
                netWorker = null;
                netClaim++;
                if (haul) { if (DeepNetSelected) State.SpendDeepNetUse(); FinishHaul(); if (!IsTier5 || 
person.IsCaptain) BeginNetUnload(person); return; }
                Net = NetState.Soaking;
                netTime = 0f;
                netSoak = DeepNetSelected ? GameData.DeepNetSoakSeconds : GameData.ShallowNetSoakSeconds;
                netFish.Clear();
                if (netFloats != null) netFloats.gameObject.SetActive(true);
                Toast($"{(DeepNetSelected ? "Deep" : "Shallow")} net set. {netSoak:0}s soak while the crew works.");
            }
            void Tear()
            {
                if (!Owns()) return;
                bool deep = DeepNetSelected;
                if (deep) State.SpendDeepNetUse();
                else State.NetInventory = Mathf.Max(0, State.NetInventory - 1);
                ResetPrimaryNet();
                Toast(deep ? $"Deep haul lost ÔÇö one use spent. {State.NetLoadoutLabel}." : $"Net torn ÔÇö catch 
lost. {State.NetInventory} shallow nets left; replacements {GameData.NetReplacementCost} coins.");
            }
            bool walking = person.WalkTo(Grid, NetAccess, () =>
            {
                if (!Owns()) return;
                FaceNet(person);
                if (person.IsCaptain) BeginNetGame(person, !haul, Complete, Cancel, Tear);
                else person.Do(haul ? "Hauling net" : "Setting net", haul ? GameData.NetHaulTime : 
GameData.NetSetTime, Complete, Cancel);
            }, Cancel);
            if (!walking) Cancel();
            return walking;
        }

        void RollCompactCatch()
        {
            netFish.Clear();
            netFish.AddRange(CatchExpectation.RollNet(State.Hull,ActiveSpot,DeepNetSelected,NetWeightRange(ActiveSpot,D
eepNetSelected).y,State.Rng));
            foreach(var f in netFish)State.OnCatch(ActiveSpot,f.kg);
        }

        static bool SmallSchool(Species species) => species == Species.Herring || species == Species.Mackerel || 
species == Species.Whiting || species == Species.Pollock;

        void FinishHaul()
        {
            int count = netFish.Count;
            foreach (var (species, kg) in netFish)
            {
                var fish = new DeckFish { Species = species, Kg = kg, Tile = NetAccess, CaughtAt = SimTime, 
FromNetBasket = true };
                fish.Root = DeckFish.BuildModel(species, kg, Boat);
                int i = IsNetFisher ? NetBasketCount : OnDeck.Count;
                fish.RestPos = IsNetFisher ? NetBasketLocal + new Vector3((i % 2 - .5f) * .1f, (i / 2) * .012f, (i % 3 
- 1) * .08f)
                    : DeckGrid.ToLocal(NetAccess) + new Vector3((i % 4 - 1.5f) * .12f, .07f, (i / 4) * .08f);
                fish.SpawnFrom = IsNetFisher ? Grid.GetLocal(NetAccess) + new Vector3(.3f, .5f, 0f) : new 
Vector3(4.4f, .5f, .2f);
                fish.Root.localPosition = fish.SpawnFrom;
                OnDeck.Add(fish);
                RecordLanding(FlowTelemetry.Kind.Net, species, kg);
                Stats.Landed++;
            }
            ResetPrimaryNet();
            Toast($"Hauled {count} fish. Bringing the catch into storage.");
        }

        void ResetPrimaryNet()
        {
            netClaim++;
            if (!NetGameActive || netGameRig == 0) ResetNetHaulGame();
            netWorker = null;
            Net = NetState.Stowed;
            netFish.Clear();
            netTime = 0f;
            primaryNetCycleMistakes = 0;
            if (netFloats != null) netFloats.gameObject.SetActive(false);
        }
    }
