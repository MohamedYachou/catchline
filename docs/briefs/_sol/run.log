        // UI041 append-only IDs: rarity controls presentation; these values are first-pass tuning.
        public static int MinimumHull(Species s) => s switch
        {
            Species.Crab => 4,
            Species.YellowfinTuna or Species.Barracuda or Species.MahiMahi or Species.Monkfish => 2,
            Species.GoldenPuffer or Species.SpottedEagleRay or Species.BlueSpottedStingray or Species.FlyingFish or 
Species.Lionfish => 2,
            Species.ApexReefShark or Species.GoldTipShark or Species.AbyssalGreatWhite or Species.AbyssalLeviathan or 
Species.GiantDevilManta or Species.AtlanticSwordfish or Species.OceanSunfish or Species.ScallopedHammerhead or 
Species.PelagicThresherShark or Species.GiantSquid => 3,
            _ => 0
        };

