        // Deckhand: carry fish to the cooler first, then bait empty hooks, then rest.
        void HandThink(Person h)
        {
            // Migrated decks assign every hauling/sorting/processing act through the scheduler.
            if (UsesDeckGraph) { IdlePatrol(h); return; }
            if (IsNetUnloading(h)) return;
            var rest = RestFor(h);
            if (h.Carrying != null)
            {
                if (!HoldFull) Stow(h);
                else if (h.Tile != rest) h.WalkTo(Grid, rest, null);
                else h.Do("Waiting", 1f, null);
                return;
            }
            if (IsPrepFisher && h.Contract.WorkPreference == DeckhandWork.Prep)
            {
                if (TryPrepWork(h) || !IsTier5) return; // Tier5 processor helps haul when input is empty.
            }
            if (IsTier5 && h.Contract.WorkPreference == DeckhandWork.Nets && !HoldFull && !NetUnloadActive && 
AssignedBasket(h) != null)
            { if(h.Loitering)h.Stop(); BeginNetUnload(h); return; }
            if (!IsTier5 && IsNetFisher && h.Contract.WorkPreference == DeckhandWork.Nets)
            {
                var basket = AssignedBasket(h);
                if (basket != null && !HoldFull)
                {
                    // Basket catches have one batch owner; another hand must never
                    // steal individual fish while that owner approaches the basket.
                    if (!NetUnloadActive) { if (h.Loitering) h.Stop(); BeginNetUnload(h); }
                    else IdlePatrol(h);
                    return;
                }
                if (!NetBasketBlocked && !HoldFull)
                {
                    if (h.Loitering) h.Stop();
                    if (TryNetWork(h)) return;
                }
                // While gear soaks, cover rod delivery/bait. A ready rig preempts
                // uncollected work next tick; a fish already held is safely delivered first.
                if (!NetsSoakingFor(h) || NetReadyForHand(h) || HoldFull) { IdlePatrol(h); return; }
                netFallbackHands.Add(h);
            }
            if (TryCarryProcessed(h)) return;
            var f = OnDeck.FirstOrDefault(x => !x.FromNetBasket && x.ClaimedBy == null && x.Age > 0.4f);
            if (f != null)
            {
                Fetch(h, f);
                return;
            }
            if (IsTier5 && !HoldFull && !NetUnloadActive && AssignedBasket(h) != null)
            { if(h.Loitering)h.Stop(); BeginNetUnload(h); return; }
            var rod = Rods.FirstOrDefault(r => r.Unlocked && r.State == RodState.Unbaited && r.BaitingBy == null && 
CanBaitRod(r));
            if (rod != null && State.HasAnyBait)
            {
                rod.BaitingBy = h;
                h.WalkTo(Grid, rod.Tile, () => Bait(h, rod), () => rod.BaitingBy = null);
                return;
            }
            IdlePatrol(h);
        }

        bool FisherAt(Rod rod) => rod.Fisher != null && !rod.Fisher.Walking && rod.Fisher.Tile == rod.Tile;

        void FisherThink(Person fisher)
        {
            if (FisherSpecialThink(fisher)) return;
            var rod = Rods.FirstOrDefault(r => r.Fisher == fisher);
            if (rod == null)
            {
                rod = Rods.LastOrDefault(r => r.Unlocked && r != Manning && r.Fisher == null);
                if (rod == null) return;
                rod.Fisher = fisher;
            }
            fisher.Pose = rod.State switch { RodState.Flying => "Cast", RodState.Waiting or RodState.Bite => "Wait", 
RodState.Reeling => "Reel", _ => "Idle" };
            if (!fisher.Idle) return;
            if (!FisherAt(rod)) { fisher.WalkTo(Grid, rod.Tile, () => fisher.Face(rod.Outward)); return; }
            // Special Tier5 jobs are dispatched before claiming a rod, using saved policy.
            fisher.Face(rod.Outward);
            if (rod.State == RodState.Unbaited && !HoldFull && rod.BaitingBy == null && CanBaitRod(rod)) Bait(fisher, 
rod);
            else if (rod.State == RodState.Ready && !HoldFull)
                fisher.Do("Casting", GameData.CastTime, () => { if (!HoldFull) rod.Cast(this, .55f); });
            else if (rod.State == RodState.Bite && !rod.FisherAttempted)
            {
                rod.FisherAttempted = true;
                fisher.FacePoint(deepLineTips[rig]); fisher.Do("Baiting deep line", DeepLineRules.BaitSeconds, Finish, 
Cancel);
            }, Cancel);
            if (!started) Cancel(); return started;
        }
        bool FisherSpecialThink(Person fisher)
        {
            if (!IsTier5) return false;
            if (!fisher.Idle) return true;
            var work = fisher.Contract.FishingWork; var rod = Rods.FirstOrDefault(r => r.Fisher == fisher);
            // Finish an already committed cast/strike/reel before applying a new preference.
            bool safe = rod == null || rod.State == RodState.Unbaited || rod.State == RodState.Ready
                || fisher.Contract.Allows(FisherTask.Rods) && rod.State == RodState.Waiting && rod.WaitRemaining > 9f;
            if (!safe) return false;
            fisher.Pose = "Idle";
            if (fisher.Contract.Allows(FisherTask.Nets))
            {
                int net=AssignedNet(fisher);
                if ((net==0 && Net==NetState.Ready || net==1 && SecondNet==NetState.Ready) && TryNetWork(fisher)) 
return true;
            }
            if (fisher.Contract.Allows(FisherTask.Crabs) && TryBuoyWork(fisher)) return true;
            if (fisher.Contract.Allows(FisherTask.DeepLines) && TryDeepLineWork(fisher)) return true;
            if (fisher.Contract.Allows(FisherTask.Nets) && TryNetWork(fisher)) return true;
            if (fisher.Contract.Allows(FisherTask.Rods)) return false;
            if (rod != null) rod.Fisher = null;
            IdlePatrol(fisher); return true;
        }
        void TickDeepLines(float dt)
        {
            if (!DeepLinesActive || CurrentMode != Mode.Fishing || !AtFishingGround || dt <= 0) return;
            for (int rig = 0; rig < FittedDeepLineCount; rig++)
            {
                var cycle = deepLines[rig];
                if (cycle.Phase == DeepLinePhase.CatchOnDeck && !OnDeck.Any(f => f.DeepLineRig == rig)) 
cycle.Collected();
                if (!cycle.Tick(dt)) continue;
                for (int n = 0; n < DeepLineRules.CatchCount(rig); n++)
                {
                    var bait = cycle.Bait;
                    var caught = DeepLineRules.Roll(State,ActiveSpot,bait);
                    var fish = new DeckFish { Species = caught.Item1, Kg = caught.Item2, Tile = deepLineTiles[rig], 
CaughtAt = SimTime, CaughtByCrew = true, DeepLineRig = rig };
                    fish.Root = DeckFish.BuildModel(fish.Species, fish.Kg, Boat);
                    fish.RestPos = Grid.GetLocal(fish.Tile) + new Vector3(.08f + n * .10f, .08f, .08f);
                    fish.SpawnFrom = deepLineTips[rig]; fish.Root.localPosition = fish.SpawnFrom;
                    OnDeck.Add(fish); Stats.Landed++; State.OnCatch(ActiveSpot, fish.Kg);
                    RecordLanding(FlowTelemetry.Kind.DeepLine, fish.Species, fish.Kg);
                }
                DeepLineHauls++;
            }
            UpdateDeepLineRopes();
        }
        void UpdateDeepLineRopes()
        {
            for (int rig = 0; rig < FittedDeepLineCount; rig++)
            {
                var line = deepLineRopes[rig]; if (line == null) continue; var cycle = deepLines[rig];
                float dropped = cycle.Phase == DeepLinePhase.Soaking ? 1
                    : cycle.Phase == DeepLinePhase.Dropping ? 1 - cycle.Remaining / DeepLineRules.DropSeconds
                    : cycle.Phase == DeepLinePhase.Raising ? cycle.Remaining / DeepLineRules.RaiseSeconds : 0;
                line.SetPosition(0, deepLineTips[rig]);
                line.SetPosition(1, Vector3.Lerp(deepLineTips[rig] - Vector3.up * .2f, new 
Vector3(deepLineTips[rig].x, -.5f, deepLineTips[rig].z), dropped));
            }
        }
    }
}
using System;
using System.Collections.Generic;
using System.Linq;
using UnityEngine;

namespace Catchline.Game.Deck
{
    // One job system for every hull (docs/MASTER-PLAN.md B3).
    public enum JobKind { Haul, Sort, TableWork, RodCycle, NetCycle, CageCycle, LineCycle, JigCycle, Relocate, 
EventResponse }
    public enum Duty { Haul, Sort, Table }

    // What the scheduler needs from a body on deck. Person implements it through an adapter in the game;
    // checks use a simulated actor.
    public interface IDeckActor
    {
        Vector2Int Tile { get; }
        bool WalkTo(Vector2Int tile, Action arrive, Action cancel);
        void Act(string label, float seconds, Action done, Action cancel);
        void Stop();
    }

    public sealed class Worker
    {
        public string Name;
        public bool Captain;
        public CrewRole Role;
        public IDeckActor Actor;
        public Duty Primary = Duty.Haul, Secondary = Duty.Sort;
        Duty? pendingPrimary, pendingSecondary;
        public Job Current;
        public readonly List<CaughtFish> Hands = new();
        // Hand capacity (B3): at most three fish or 6 kg.
        public int HandCount = 3;
        public float HandKg = 6f;
        public Station Operating; // fishers: the gear station they run
        public Func<bool> Available = () => true; // body free for a new job (not mid legacy task)

        // Duties switch after the current job (M1 acceptance).
        public void SetDuties(Duty primary, Duty secondary)
        {
            if (Current == null) { Primary = primary; Secondary = secondary; pendingPrimary = pendingSecondary = null; 
}
            else { pendingPrimary = primary; pendingSecondary = secondary; }
        }
        internal void ApplyPending()
        {
            if (pendingPrimary.HasValue) Primary = pendingPrimary.Value;
            if (pendingSecondary.HasValue) Secondary = pendingSecondary.Value;
            pendingPrimary = pendingSecondary = null;
        }
        public bool Idle => Current == null;
    }

    // Where carried fish go. The hold and overboard are sinks; baskets take a reserved slot.
    public sealed class Drop
    {
        public Basket Basket;
        public Station Station;      // access point (basket owner or the hold hatch)
        public bool Hold, Overboard;
        public static Drop To(Basket b) => new() { Basket = b, Station = b.Owner };
    }

    public sealed class Job
    {
        public JobKind Kind;
        public Worker Worker;
        public Basket Source;
        public readonly List<CaughtFish> Fish = new();
        public Drop Target;
        public Station At;
        public string Label;
        public bool Started, Finished, Cancelled;
        internal int reserved;
        public override string ToString() => $"{Kind} {Fish.Count} fish {Source?.Id}├óÔÇáÔÇÖ{(Target?.Hold == true ? 
"hold" : Target?.Overboard == true ? "overboard" : Target?.Basket?.Id)}";
    }

    // Sort decision for one fish (B2 routing): undersize and thrown classes go back; the rest go to SortOut,
    // flagged for the table when the table wants them.
    public enum SortOutcome { Throw, Keep, Table }
}

