            {
                if (kb != null && kb.escapeKey.wasPressedThisFrame) CancelNetHaulGame();
                else if (!netOrdersOpen && Application.isFocused)
                {
                    var netPointer = Pointer.current;
                    bool cancel = netPointer != null && 
NetGameCancelRect.Contains(ToGui(netPointer.position.ReadValue()));
                    if ((kb != null && kb.spaceKey.wasPressedThisFrame) || (netPointer != null && 
netPointer.press.wasPressedThisFrame && !cancel)) TapNetGame();
                }
                return;
            }
