using System;
using System.Collections.Generic;
using System.Linq;
using UnityEngine;

namespace Catchline.Game.Deck
{
    // Scheduler (docs/MASTER-PLAN.md B3): idle deckhands take the highest-pressure job of their primary
    // duty (fullest basket, then nearest), else their secondary. Fishers run their station's cycle elsewhere;
    // the captain only does what the player taps. Fish keep their identity; every move is claim-checked.
    public sealed class DeckScheduler
    {
        public readonly DeckGraph Deck;
        public bool Sailing; // Transit permits sorting and stowing, never processing.
        public readonly List<Worker> Workers = new();
        public sealed class LooseFish { public CaughtFish Fish; public Vector2Int Tile; public object Claim; }
        public readonly List<LooseFish> Loose = new();
        readonly HashSet<CaughtFish> forTable = new();

        // Keep rule and table orders live outside; default is undersize back, purple+ to a table when fitted.
        public Func<CaughtFish, SortOutcome> Decide;
        public Func<float> HoldRemainingKg = () => float.MaxValue;
        public Action<CaughtFish> OnStowed, OnThrown;
        public Action<Job, CaughtFish> OnTableDone; // M3 product chain; default passes the fish on to TableOut
        // Seconds for one act; the game wires these to the one work-speed model (CARDS-AND-SPEEDS ├é┬º1, ├é┬º4).
        public Func<Worker, JobKind, float> ActSeconds = (w, k) => k switch { JobKind.Sort => 1.2f, JobKind.TableWork 
=> 3f, _ => .5f };
        public Func<Worker, float> StowSeconds = w => .6f;

        // Integrity: every landed fish is somewhere; nothing is duplicated or lost.
        public int Landed, Stowed, Thrown;
        public int OnDeck => Deck.Baskets.Sum(b => b.Count) + Loose.Count + Workers.Sum(w => w.Hands.Count);
        public bool Balanced => Landed == Stowed + Thrown + OnDeck;

        public DeckScheduler(DeckGraph deck)
        {
            Deck = deck;
            Decide = f => FishRules.Undersize(f) ? SortOutcome.Throw
                : FishRules.Class(f) >= FishClass.Purple && Deck.OfKind(StationKind.ProcessTable).Any() ? 
SortOutcome.Table : SortOutcome.Keep;
        }

        // ---- landing ------------------------------------------------------------------------

        // Gear lands a fish into its basket, or loose beside the station when it is too big or the basket is full.
        public bool Land(Station gear, CaughtFish f)
        {
            Landed++;
            if (gear.Out != null && FishRules.FitsBasket(f) && gear.Out.Put(f, false)) return true;
            Loose.Add(new LooseFish { Fish = f, Tile = Deck.Access(gear) });
            return gear.Out != null && FishRules.FitsBasket(f); // false: oversize fish, deck tile now blocked by it
        }
        public bool GearCanLand(Station gear) => gear.Out == null || !gear.Out.Full;

        // ---- scheduling ---------------------------------------------------------------------

        public void Tick()
        {
            foreach (var w in Workers)
            {
                if (!w.Idle || w.Captain || w.Role == CrewRole.Fisherman || !w.Available()) continue;
                w.ApplyPending();
                var job = Pick(w);
                if (job != null) Start(job);
            }
        }

        IEnumerable<Duty> Duties(Worker w) => w.Role == CrewRole.Engineer ? new[] { Duty.Haul } : new[] { w.Primary, 
w.Secondary };

        public Job Pick(Worker w)
        {
            foreach (var duty in Duties(w).Distinct())
            {
                var job = duty switch { Duty.Sort => PickSort(w), Duty.Table => PickTable(w), _ => PickHaul(w) };
                if (job != null) return job;
            }
            return null;
        }

        float Dist(Worker w, Station s) => Deck.Distance(w.Actor.Tile, Deck.Access(s));

        Job PickSort(Worker w)
        {
            var s = Deck.OfKind(StationKind.SortTable).Where(t => t.Worker == null && t.In != null && t.Out != null && 
t.In.UnclaimedCount > 0 && t.Out.Free > 0)
                .OrderByDescending(t => t.In.Fill).ThenBy(t => Dist(w, t)).FirstOrDefault();
            if (s == null) return null;
            var job = new Job { Kind = JobKind.Sort, Worker = w, Source = s.In, At = s, Label = "Sorting", Target = 
Drop.To(s.Out) };
            var f = s.In.Unclaimed.First();
            if (!s.In.Claim(f, job) || !s.Out.Reserve(1)) { s.In.Release(f, job); return null; }
            job.Fish.Add(f); job.reserved = 1; s.Worker = w;
            return job;
        }

        Job PickTable(Worker w)
        {
            if (Sailing) return null;
            var s = Deck.OfKind(StationKind.ProcessTable).Where(t => t.In != null && t.Out != null && 
t.In.UnclaimedCount > 0 && t.Out.Free > 0
                    && Workers.Count(o => o.Current?.At == t && o.Current.Kind == JobKind.TableWork) < t.Places)
                .OrderByDescending(t => t.In.Fill).ThenBy(t => Dist(w, t)).FirstOrDefault();
            if (s == null) return null;
            var job = new Job { Kind = JobKind.TableWork, Worker = w, Source = s.In, At = s, Label = "Processing", 
Target = Drop.To(s.Out) };
            var f = s.In.Unclaimed.First();
            if (!s.In.Claim(f, job) || !s.Out.Reserve(1)) { s.In.Release(f, job); return null; }
            job.Fish.Add(f); job.reserved = 1;
            return job;
        }

        // Where fish from a basket go next.
        Drop NextFor(Basket from, CaughtFish f)
        {
            switch (from.Kind)
            {
                case BasketKind.SortOut:
                    if (forTable.Contains(f))
                    {
                        if (Sailing) return null;
                        var table = Deck.OfKind(StationKind.ProcessTable).Where(t => t.In != null && t.In.Free > 
0).OrderBy(t => (t.Position - from.Position).sqrMagnitude).FirstOrDefault();
                        if (table != null) return Drop.To(table.In);
                    }
                    return HoldDrop();
                case BasketKind.TableOut: return HoldDrop();
                default:
                    var sort = Deck.OfKind(StationKind.SortTable).Where(t => t.In != null && t.In.Free > 0).OrderBy(t 
=> (t.Position - from.Position).sqrMagnitude).FirstOrDefault();
                    return sort != null ? Drop.To(sort.In) : Deck.OfKind(StationKind.SortTable).Any() ? null : 
HoldDrop();
            }
        }
        Drop HoldDrop() => Deck.Hold != null ? new Drop { Hold = true, Station = Deck.Hold } : null;

        Job PickHaul(Worker w)
        {
            // Loose fish block a deck tile and come first.
            foreach (var lf in Loose.Where(l => l.Claim == null).OrderBy(l => Deck.Distance(w.Actor.Tile, l.Tile)))
            {
                if (FishRules.NeedsTwo(lf.Fish) && w.HandKg < lf.Fish.Kg) continue; // two-carrier fish wait for a 
strong lifter or a pair (M2 ability)
                var drop = Decide(lf.Fish) == SortOutcome.Throw ? new Drop { Overboard = true, Station = null } : 
HoldDrop();
                if (drop == null || drop.Hold && HoldRemainingKg() < lf.Fish.Kg) continue;
                var job = new Job { Kind = JobKind.Haul, Worker = w, Target = drop, Label = "Hauling" };
                lf.Claim = job; job.Fish.Add(lf.Fish);
                return job;
            }
            var sources = Deck.Baskets.Where(b => b.UnclaimedCount > 0 && b.Kind is not (BasketKind.SortIn or 
BasketKind.TableIn))
                .OrderByDescending(b => b.Fill).ThenBy(b => Dist(w, b.Owner));
            foreach (var b in sources)
            {
                var job = BuildHaul(w, b);
                if (job != null) return job;
            }
            return null;
        }

        // One load from a basket: up to the hand limits, all bound for the same place.
        Job BuildHaul(Worker w, Basket b)
        {
            if (b.UnclaimedCount == 0) return null;
            var drop = NextFor(b, b.Unclaimed.First());
            if (drop == null) return null;
            var job = new Job { Kind = JobKind.Haul, Worker = w, Source = b, Target = drop, Label = "Hauling" };
            float kg = 0;
            foreach (var f in b.Unclaimed.ToList())
            {
                if (job.Fish.Count >= w.HandCount || kg + f.Kg > w.HandKg && job.Fish.Count > 0) break;
                var d = NextFor(b, f);
                if (d == null || d.Hold != drop.Hold || d.Basket != drop.Basket) continue;
                if (drop.Basket != null && drop.Basket.Free < job.Fish.Count + 1) break;
                if (drop.Hold && HoldRemainingKg() < kg + f.Kg) break;
                b.Claim(f, job); job.Fish.Add(f); kg += f.Kg;
            }
            if (job.Fish.Count == 0) return null;
            if (drop.Basket != null) { drop.Basket.Reserve(job.Fish.Count); job.reserved = job.Fish.Count; }
            return job;
        }

        // ---- running ------------------------------------------------------------------------

        void Start(Job job)
        {
            var w = job.Worker; w.Current = job; job.Started = true;
            switch (job.Kind)
            {
                case JobKind.Sort: case JobKind.TableWork: RunBench(job); break;
                default: RunHaul(job); break;
            }
using System.Collections.Generic;
using System.Linq;
using UnityEngine;

namespace Catchline.Game.Deck
{
    // Deck graph types (docs/MASTER-PLAN.md B2). Positions are boat-local metres, tiles are the hull grid.
    public enum StationKind { Rod, Net, Cage, Line, Jig, SortTable, ProcessTable, HoldHatch, BaitBin, NavPost, 
Lantern, Generator, DeckLight, LineHauler, Unknown }
    public enum BasketKind { RodOut, JigOut, NetOut, CageOut, LineOut, SortIn, SortOut, TableIn, TableOut }

    public enum FishClass { White, Green, Blue, Purple, Gold, Red }

    public static class FishRules
    {
        // BLUEPRINT ├é┬º3.2: bottom 25% of the species weight range is undersize and always goes back.
        public static bool Undersize(CaughtFish f)
        {
            var d = GameData.Get(f.Species);
            return f.Kg < d.MinKg + .25f * (d.MaxKg - d.MinKg);
        }
        public static FishClass Class(CaughtFish f) => CatchPresentation.Tier(f.Species, f.Kg) switch
        {
            CatchTier.BigCommon => FishClass.Green, CatchTier.Rare => FishClass.Blue, CatchTier.BigRare => 
FishClass.Purple,
            CatchTier.Legendary => FishClass.Gold, CatchTier.Mythical => FishClass.Red, _ => FishClass.White
        };
        // B2: over 5 kg a fish lands loose beside its station; over 15 kg it needs two carriers.
        public const float BasketMaxKg = 5f, TwoCarrierKg = 15f;
        public static bool FitsBasket(CaughtFish f) => f.Kg <= BasketMaxKg;
        public static bool NeedsTwo(CaughtFish f) => f.Kg > TwoCarrierKg;
    }

    public sealed class Basket
    {
        public readonly string Id;
        public readonly BasketKind Kind;
        public readonly Station Owner;
        public Vector3 Position;
        public int CapacityCount;
        public float CapacityKg = float.MaxValue;
        public readonly List<CaughtFish> Fish = new();
        // A fish is claimed by at most one job; free slots are reserved by jobs bringing fish in.
        readonly Dictionary<CaughtFish, object> claims = new();
        int reservedSlots;

        public Basket(string id, BasketKind kind, Station owner, Vector3 position)
        {
            Id = id; Kind = kind; Owner = owner; Position = position; CapacityCount = DefaultCapacity(kind);
        }

        // B2 default capacities.
        public static int DefaultCapacity(BasketKind k) => k switch
        {
            BasketKind.RodOut => 6, BasketKind.JigOut => 8, BasketKind.NetOut => 16, BasketKind.CageOut => 6, 
BasketKind.LineOut => 4,
            BasketKind.SortIn => 12, BasketKind.SortOut => 12, BasketKind.TableIn => 10, _ => 8
        };

        public float Kg => Fish.Sum(f => f.Kg);
        public int Count => Fish.Count;
        public int Free => Mathf.Max(0, CapacityCount - Fish.Count - reservedSlots);
        public float Fill => CapacityCount > 0 ? (Fish.Count + reservedSlots) / (float)CapacityCount : 1f;
        public bool Full => Free <= 0;
        public IEnumerable<CaughtFish> Unclaimed => Fish.Where(f => !claims.ContainsKey(f));
        public int UnclaimedCount => Fish.Count(f => !claims.ContainsKey(f));

        public bool Claim(CaughtFish f, object by)
        {
            if (!Fish.Contains(f) || claims.ContainsKey(f)) return false;
            claims[f] = by; return true;
        }
        public void Release(CaughtFish f, object by) { if (claims.TryGetValue(f, out var o) && o == by) 
claims.Remove(f); }
        public bool IsClaimed(CaughtFish f) => claims.ContainsKey(f);
        public bool Reserve(int slots) { if (Free < slots) return false; reservedSlots += slots; return true; }
        public void Unreserve(int slots) => reservedSlots = Mathf.Max(0, reservedSlots - slots);

        // Moving fish never duplicates or loses one: Take removes only what this claimant holds.
        public bool Take(CaughtFish f, object by)
        {
            if (!claims.TryGetValue(f, out var o) || o != by) return false;
            claims.Remove(f); return Fish.Remove(f);
        }
        public bool Put(CaughtFish f, bool fromReservation)
        {
            if (fromReservation) Unreserve(1);
            else if (Free <= 0) return false;
            if (Fish.Contains(f)) return false;
            Fish.Add(f); return true;
        }
    }

    public sealed class Station
