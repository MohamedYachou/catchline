        static void Formula()
        {
            // duration = base / (skill / 100) / levelMult ; walk = 2.2 m/s * (skill / 100) * levelMult
            Check(Mathf.Approximately(WorkSpeed.Duration(2f, 100f, 1f), 2f), "skill 100 level 1 runs at base 
duration");
            Check(Mathf.Approximately(WorkSpeed.Duration(2f, 50f, 1f), 4f), "skill 50 takes twice as long");
            Check(Mathf.Approximately(WorkSpeed.Duration(1.5f, 100f, 1.5f), 1f), "level multiplier shortens the base 
duration");
            Check(Mathf.Approximately(WorkSpeed.Walk(100f, 1f), 2.2f) && Mathf.Approximately(GameData.WalkSpeed, 
2.2f), "walk 2.2 m/s at skill 100");
            Check(Mathf.Approximately(WorkSpeed.Walk(65f, 1.03f), 2.2f * .65f * 1.03f), "walk scales with skill and 
level");
            Check(Mathf.Approximately(GameData.PickupTime, .5f) && Mathf.Approximately(GameData.StowTime, .6f), 
"pickup 0.5 s and stow 0.6 s base durations");
            Check(Mathf.Approximately(GameData.BaitTime, 1f) && Mathf.Approximately(GameData.CastTime, .5f), "bait 1.0 
s and cast 0.5 s base durations");
            Check(Mathf.Approximately(GameData.NetSetTime, 2f) && Mathf.Approximately(GameData.NetHaulTime, 5f), "net 
set 2 s and haul 5 s base durations");
            var p = new Person("M0 probe", false, Vector3.zero);
            Check(Mathf.Approximately(p.Speed, 1f) && p.Skill == 100f && p.LevelMult == 1f, "a new person is skill 
100, level 1");
        }

        static void RemovedSymbols()
        {
            foreach (var name in new[] { "CrewWorkSpeed", "DeckhandHandlingSpeed", "CompactPickupTime", 
"CompactStowTime", "MarketDropPerFish", "MarketRecovery" })
