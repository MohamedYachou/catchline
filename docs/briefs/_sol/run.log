        public bool TryDeepLineWork(Person fisher)
        {
            if (!DeepLinesActive || CurrentMode != Mode.Fishing || !AtFishingGround || fisher == null || !fisher.Idle 
|| fisher.Carrying != null
                || fisher.Contract?.Role != CrewRole.Fisherman || HoldFull || 
!fisher.Contract.Allows(FisherTask.DeepLines)
                || State.SelectDeepLineBait(fisher.Contract)==BaitPermission.None) return false;
            int rig = Enumerable.Range(0, FittedDeepLineCount).Where(i => deepLines[i].Phase == DeepLinePhase.Empty && 
deepLineWorkers[i] == null).DefaultIfEmpty(-1).First();
            if (rig < 0) return false;
            deepLineWorkers[rig] = fisher;
            bool Owns() => deepLineWorkers[rig] == fisher;
            void Cancel() { if (Owns()) deepLineWorkers[rig] = null; }
            void Finish()
            {
                if (!Owns()) return;
                if (!DeepLinesActive || CurrentMode != Mode.Fishing || !AtFishingGround || HoldFull) { Cancel(); 
return; }
                var bait = State.SelectDeepLineBait(fisher.Contract);
                if (bait != BaitPermission.None && deepLines[rig].Phase == DeepLinePhase.Empty
                    && State.TakeDeepLineBait(fisher.Contract)) deepLines[rig].Deploy(bait);
                Cancel();
            }
            bool started = fisher.WalkTo(Grid, deepLineTiles[rig], () =>
            {
                if (!Owns()) return;
                fisher.FacePoint(deepLineTips[rig]); fisher.Do("Baiting deep line", DeepLineRules.BaitSeconds, Finish, 
Cancel);
            }, Cancel);
            if (!started) Cancel(); return started;
        }
