                coastalUi.Art("log/" + i + "/fish", new Rect(6, catalogY + 4, 114, 68), found ? 
FishPortrait(f.Species) : "fish-unknown", catalog);
                coastalUi.Label("log/" + i + "/name", new Rect(138, catalogY + 5, catalogWidth - 270, 29), found ? 
