using System;
using System.Collections.Generic;
using System.Linq;
using Catchline.Game;
using Catchline.Game.Deck;
using UnityEngine;

namespace Catchline.EditorTools
{
    // M1 core (docs/MASTER-PLAN.md M1): station files load for all five hulls, every station is reachable,
    // and the scheduler moves fish rod ├óÔÇáÔÇÖ RodOut ├óÔÇáÔÇÖ SortIn ├óÔÇáÔÇÖ SortOut ├óÔÇáÔÇÖ hold with one claim 
at a time,
    // throwing undersize back and losing nothing when a carry is cancelled.
    public static class M1GraphChecks
    {
        static void Check(bool ok, string what) { if (!ok) throw new Exception("[Catchline] M1 check failed: " + 
what); }

        // Simulated body: walks at 1.2 m/s along the cached path; acts take their seconds.
        sealed class SimActor : IDeckActor
        {
            public Vector2Int Tile { get; set; }
            readonly DeckGraph deck; public readonly SimClock Clock;
            public SimActor(DeckGraph d, SimClock c, Vector2Int t) { deck = d; Clock = c; Tile = t; }
            public bool WalkTo(Vector2Int tile, Action arrive, Action cancel)
            {
                if (!deck.Reachable(Tile, tile)) return false;
                float seconds = deck.Distance(Tile, tile) / 1.2f; var to = tile;
                Clock.After(seconds, this, () => { Tile = to; arrive(); });
                return true;
            }
            public void Act(string label, float seconds, Action done, Action cancel) => Clock.After(seconds, this, 
done);
            public void Stop() => Clock.Drop(this);
        }
        sealed class SimClock
        {
            public float Now;
            readonly List<(float at, object owner, Action act)> queue = new();
            public void After(float s, object owner, Action a) => queue.Add((Now + s, owner, a));
            public void Drop(object owner) => queue.RemoveAll(q => q.owner == owner);
            public void Advance(float dt)
            {
                float end = Now + dt;
                for (;;)
                {
                    var due = queue.Where(q => q.at <= end).OrderBy(q => q.at).FirstOrDefault();
                    if (due.act == null) break;
                    queue.Remove(due); Now = due.at; due.act();
                }
                Now = end;
            }
        }

        static CaughtFish Fish(Species s, float t) { var d = GameData.Get(s); return new CaughtFish { Species = s, Kg 
= Mathf.Lerp(d.MinKg, d.MaxKg, t) }; }

        public static void Run()
        {
            for (int h = 0; h < GameData.Hulls.Length; h++)
            {
                var hull = GameData.Hulls[h];
                var deck = DeckGraph.Load(hull);
                Check(deck != null, hull.Model + " station file in ArtLibrary");
                Check(deck.Hold != null && deck.OfKind(StationKind.SortTable).Any(), hull.Model + " has hold and sort 
table");
                var from = deck.Access(deck.Hold);
                foreach (var s in deck.Stations)
                    Check(deck.Reachable(from, deck.Access(s)), $"{hull.Model} {s.Id} reachable from the hold");
                foreach (var g in deck.Stations.Where(s => s.IsGear))
                    Check(g.Out != null, $"{hull.Model} {g.Id} has an output basket");
                Flow(hull, deck);
                Debug.Log($"[Catchline] M1 {hull.Model}: {deck.Stations.Count} stations, {deck.Baskets.Count} baskets 
reachable; flow ok");
            }
            Debug.Log("[Catchline] M1 GRAPH CHECKS PASSED");
        }

        static void Flow(HullDef hull, DeckGraph deck)
        {
            var clock = new SimClock();
            var sched = new DeckScheduler(deck);
            var stowed = new List<CaughtFish>(); var thrown = new List<CaughtFish>();
            sched.OnStowed = stowed.Add; sched.OnThrown = thrown.Add;
            var hold = deck.Access(deck.Hold);
            var hauler = new Worker { Name = "Hauler", Role = CrewRole.Deckhand, Primary = Duty.Haul, Secondary = 
Duty.Sort, Actor = new SimActor(deck, clock, hold) };
            var sorter = new Worker { Name = "Sorter", Role = CrewRole.Deckhand, Primary = Duty.Sort, Secondary = 
Duty.Haul, Actor = new SimActor(deck, clock, hold) };
            sched.Workers.Add(hauler); sched.Workers.Add(sorter);
            var rod = deck.OfKind(StationKind.Rod).First();
            var keep = Fish(Species.Mackerel, .9f); var small = Fish(Species.Mackerel, .05f);
            sched.Land(rod, keep); sched.Land(rod, small);
            var claimed = new HashSet<CaughtFish>();
            for (int t = 0; t < 1200 && stowed.Count + thrown.Count < 2; t++)
            {
                sched.Tick(); clock.Advance(.1f);
                Check(sched.Balanced, hull.Model + " no fish lost or duplicated");
                foreach (var w in sched.Workers) if (w.Current != null) foreach (var f in w.Current.Fish) 
Check(!sched.Workers.Any(o => o != w && o.Current != null && o.Current.Fish.Contains(f)), "one claim per fish");
            }
            Check(stowed.Contains(keep), hull.Model + " keeper reaches the hold through the sort table");
            Check(thrown.Contains(small) && !stowed.Contains(small), hull.Model + " undersize never reaches the hold");

            // Cancelling mid-carry loses no fish.
            var a = Fish(Species.Herring, .8f); var b = Fish(Species.Herring, .9f);
            sched.Land(rod, a); sched.Land(rod, b);
            for (int t = 0; t < 400 && !sched.Workers.Any(w => w.Hands.Count > 0); t++) { sched.Tick(); 
clock.Advance(.05f); }
            var carrier = sched.Workers.FirstOrDefault(w => w.Hands.Count > 0);
            Check(carrier != null, hull.Model + " a carry starts");
            sched.Cancel(carrier.Current);
            Check(sched.Balanced && carrier.Hands.Count == 0, hull.Model + " cancel mid-carry keeps every fish");

            // Duties switch after the current job, not during it.
            sched.Tick(); clock.Advance(.05f);
            var busy = sched.Workers.FirstOrDefault(w => w.Current != null);
            if (busy != null)
            {
                var before = busy.Primary; busy.SetDuties(Duty.Table, Duty.Haul);
                Check(busy.Primary == before, hull.Model + " duty change waits for the current job");
            }
            for (int t = 0; t < 1200 && sched.OnDeck > 0; t++) { sched.Tick(); clock.Advance(.1f); 
Check(sched.Balanced, hull.Model + " balanced while clearing"); }
            Check(sched.OnDeck == 0, hull.Model + " deck clears (" + sched.OnDeck + " left)");
        }
using System;
using System.Collections.Generic;
using System.Linq;
using Catchline.Game;
using Catchline.Game.Deck;
using UnityEditor.SceneManagement;
using UnityEngine;

namespace Catchline.EditorTools
{
    // Exercise the live Person adapter and voyage bridge, rather than a second scheduler simulation.
    public static class M1HullChecks
    {
        static void Check(bool ok, string text) { if (!ok) throw new Exception("[Catchline] M1 hull: " + text); }
        static void Advance(VoyageGame g, float seconds)
        {
            for (float t = 0; t < seconds; t += .05f)
            {
                g.Tick(.05f);
                Check(g.Scheduler.Balanced, "fish conservation");
                var claimed = new HashSet<CaughtFish>();
                foreach (var w in g.Scheduler.Workers.Where(w => w.Current != null))
                    foreach (var f in w.Current.Fish) Check(claimed.Add(f), "single job claim per fish");
            }
        }
        static void Until(VoyageGame g, Func<bool> done, string text, float seconds = 60)
        {
            for (float t = 0; t < seconds && !done(); t += .05f) Advance(g, .05f);
            Check(done(), text);
        }
        public static void Run(int hull)
        {
            ArtImport.BuildLibrary();
            EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);
            var g = new GameObject("M1 live hull").AddComponent<VoyageGame>();
            g.SessionOnly = true; g.Build(); g.State.Hull = hull; g.State.Coins = 10000; g.State.Fuel = 
g.State.FuelCapacity;
            for (int i = 0; i < 2; i++)
            {
                g.State.EnsureCrewRoleOffers();
                Check(g.State.Hire(g.State.Board.First(c => c.Role == CrewRole.Deckhand)), "hire two deckhands");
            }
            typeof(VoyageGame).GetMethod("RebuildBoat", System.Reflection.BindingFlags.Instance | 
System.Reflection.BindingFlags.NonPublic).Invoke(g, new object[] { false });
            g.SyncCrew(); g.SetSail();
            for (float t = 0; t < 120 && g.CurrentMode != VoyageGame.Mode.Fishing; t += .05f) g.Tick(.05f);
            Check(g.CurrentMode == VoyageGame.Mode.Fishing && g.UsesDeckGraph, "live hull uses graph");
            var deck = g.DeckGraph; var sched = g.Scheduler;
            foreach (var s in deck.Stations) Check(deck.Reachable(deck.Access(deck.Hold), deck.Access(s)), s.Id + " 
reachable");
            var hands = sched.Workers.Where(w => !w.Captain).ToArray();
            hands[0].SetDuties(Duty.Haul, Duty.Haul); hands[1].SetDuties(Duty.Sort, Duty.Sort);
            float kg = GameData.Get(Species.Mackerel).MaxKg * .9f;
            var rod = g.Rods[0]; var basket = g.GearStation(StationKind.Rod, 0).Out;
            g.LandFish(rod, Species.Mackerel, kg);
            Check(basket.Count == 1 && g.OnDeck.Count == 0, "rod lands in basket");
            Until(g, () => hands[0].Hands.Count > 0, "hauler picks up catch");
            var active = hands[0].Current;
            hands[0].SetDuties(Duty.Sort, Duty.Haul);
            Check(hands[0].Current == active && hands[0].Primary == Duty.Haul, "duty change deferred during job");
            sched.Cancel(active);
            Check(sched.Balanced, "cancel is lossless");
            Until(g, () => sched.Stowed == 1, "rod to sort to hold after cancellation");
            g.LandFish(rod, Species.Herring, GameData.Get(Species.Herring).MinKg);
            Until(g, () => sched.Thrown == 1, "undersize thrown back");
            Check(g.Cooler.Count == 1, "undersize never in hold");
            // Sustained live trace: sparse arrivals allow every hull to clear without overflowing the hold.
            for (int i = 0; i < 6; i++) { g.LandFish(rod, Species.Mackerel, kg); Advance(g, 20); }
            Check(sched.Stowed == 7 && sched.OnDeck == 0 && hands.All(w => w.Idle), "120 second trace drained with no 
stuck worker");
            if (hull == 2)
            {
                hands[0].SetDuties(Duty.Haul, Duty.Haul); hands[1].SetDuties(Duty.Sort, Duty.Sort);
                var field = typeof(VoyageGame).GetField("netFish", System.Reflection.BindingFlags.Instance | 
System.Reflection.BindingFlags.NonPublic);
                var pile = (List<(Species, float)>)field.GetValue(g);
                for (int i = 0; i < 14; i++) pile.Add((Species.Mackerel, kg));
                typeof(VoyageGame).GetMethod("FinishHaul", System.Reflection.BindingFlags.Instance | 
System.Reflection.BindingFlags.NonPublic).Invoke(g, null);
                Check(g.GearStation(StationKind.Net, 0).Out.Count == 14 && g.OnDeck.Count == 0, "net unload enters 
graph");
                Until(g, () => sched.Stowed == 21, "14 fish net pile sorted and stowed by sorter and hauler under 60 
seconds", 59.9f);
            }
            Debug.Log("[Catchline] M1 " + g.State.HullDef.Model.ToUpperInvariant() + " CHECKS PASSED");
        }
    }
    public static class M1SkiffChecks { public static void Run() => M1HullChecks.Run(1); }
    public static class M1CompactChecks { public static void Run() => M1HullChecks.Run(2); }
    public static class M1PrepChecks { public static void Run() => M1HullChecks.Run(3); }
    public static class M1BuoyChecks { public static void Run() => M1HullChecks.Run(4); }
}
