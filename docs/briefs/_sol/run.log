diff --git a/Assets/Scripts/Game/VoyageHud.cs b/Assets/Scripts/Game/VoyageHud.cs
index f9602163067b7e8023d8695782593dcf08e55f5b..f582f7ec302d150069c94e5228f712db37ffc730
--- a/Assets/Scripts/Game/VoyageHud.cs
