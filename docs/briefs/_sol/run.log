                IButton("cast/again", new Rect(x + 12, r.y + 43, width * .56f - 16, 48), HoldFull ? "Cooler full" : 
"Throw again", () => ThrowAgain(), true, !HoldFull);
                IButton("cast/leave", new Rect(x + width * .56f + 4, r.y + 43, width * .44f - 16, 48), "Leave rod", 
LeaveFishing, false);
                return;
            }
            if (rod == null)
            {
                string hint = ShowTips ? VoyageHint() : null;
                // Guidance sits top centre between the status slab and the crew rail; a toast takes its place.
                if (hint != null && (toast == null || SimTime >= toastUntil)) coastalUi.Toast("guide", hint, 
"v2-icon-tick", Edge, HudGapLeft, HudGapRight);
                return;
            }
            float height = compactInterface ? 146 : 172;
            var box = new Rect(x, ih - height - 18, width, height);
            coastalUi.Box("strike", box); Block(box);
            coastalUi.Art("strike/sea", new Rect(x + 8, box.y + 43, width - 16, height - 52), "strike-water");
            string title = rod.State == RodState.Bite ? "The bobber is under!" : rod.State == RodState.Waiting ? 
rod.Nibbling ? "A nibble├óÔé¼┬ª wait for it" : "Watch the bobber" : rod.State == RodState.Reeling ? "You've hooked 
one!" : "Casting your line├óÔé¼┬ª";
            coastalUi.Label("strike/title", new Rect(x + 12, box.y + 6, width - 24, 32), title, 21, null, 
TextAnchor.MiddleCenter);
            float cy = box.y + height * .60f;
            coastalUi.Art("strike/fish", new Rect(x + width * .25f + Mathf.Sin(SimTime) * 18, cy, 76, 32), 
"fish-shadow");
            coastalUi.Art("strike/bobber", new Rect(x + width / 2 - 25, cy - 24, 50, 50), rod.State == RodState.Bite ? 
"bobber-underwater" : rod.Nibbling ? "bobber-dipped" : "bobber-floating");
            if (rod.State == RodState.Bite)
            {
                IButton("strike/tap", new Rect(x + width - 104, cy - 24, 88, 48), "Strike!", StrikeTap);
                coastalUi.Bar("strike/time", new Rect(x + 22, box.yMax - 23, width - 44, 9), 1 - rod.BiteProgress, 
true);
        void EnterHarbour(bool arrived)
        {
            ClearPrepWork();
            State.Chum = 0;
            CurrentMode = Mode.Harbour;
            if (arrived)
            {
                State.UnsoldCatch.Clear();
                foreach (var fish in Cooler)
                    State.UnsoldCatch.Add(new CaughtFish { Species = fish.Species, Kg = fish.Kg,
                        StowedAt = -Mathf.Max(0f, SimTime - fish.StowedAt)});
                State.BestVoyageKg = Mathf.Max(State.BestVoyageKg, State.UnsoldCatch.Sum(f => f.Kg));
                State.UnsoldMinutes = (SimTime - voyageStart) / 60f;
                Cooler.Clear();
                if (State.UnsoldCatch.Count == 0) State.EndVoyage(new SaleReport());
                Toast(State.UnsoldCatch.Count > 0 ? "Haul safely ashore! Tap Sell haul to collect your coins." : "Back 
in Gull Harbour.");
                hudTab = HudTab.Market;
                panelOpen = true;
            }
            SyncCrew();
            Manning = null;
            AwaitingCast = false;
            Captain.Rowing = false;
            Captain.Place(SeatTile);
            Captain.Face(Vector3.forward);
            Hand?.Place(HandRest);
            foreach (var p in ExtraPeople) p.Place(RestFor(p));
