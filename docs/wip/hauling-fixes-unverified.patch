@@ -132,8 +132,12 @@ public bool CaptainNetAction()
             bool oldCastChoice = AwaitingCast;
             Manning = null;
             AwaitingCast = false;
-            if (Net == NetState.Stowed && NetBasketBlocked) { BeginNetUnload(Captain); return true; }
-            bool started = Net == NetState.Ready ? HaulNet() : SetNet();
+            // Deck-graph hulls keep the net catch in the scheduler's basket, not the old deck list: "Unload catch" tapped
+            // there used to start nothing at all. The captain carries one load from it, like the basket's Carry bubble.
+            if (Net == NetState.Stowed && NetBasketBlocked && !UsesDeckGraph) { BeginNetUnload(Captain); return true; }
+            bool started = Net == NetState.Stowed && NetBasketBlocked
+                ? DeckGraph.OfKind(Deck.StationKind.Net).Select(s => s.Out).Where(b => b != null && b.UnclaimedCount > 0).Any(CaptainHaulFrom)
+                : Net == NetState.Ready ? HaulNet() : SetNet();
             if (!started) { Manning = oldRod; AwaitingCast = oldCastChoice; }
             return started;
         }
