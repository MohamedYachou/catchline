+using System.Collections.Generic;
+using System.Linq;
+using UnityEngine;
+
+namespace Catchline.Game
+{
+    public partial class VoyageGame
+    {
+        public List<CaughtFish> CurrentHaul()
+        {
+            var haul = new List<CaughtFish>(Cooler);
+            foreach (var fish in OnDeck.Concat(People.Where(p => p.Carrying != null).Select(p => p.Carrying)))
+                haul.Add(new CaughtFish { Species = fish.Species, Kg = fish.Kg, StowedAt = fish.CaughtAt });
+            return haul;
+        }
+
+        public string FreshnessStatus(List<CaughtFish> haul, float now)
+        {
+            if (haul.Count == 0) return "Fresh for 1 min after each catch";
+            if (State.Has(UpgradeId.IceBox)) return "Iced · full value preserved";
+            float oldest = haul.Max(f => Mathf.Max(0f, now - f.StowedAt));
+            float grace = GameData.FreshnessGraceSeconds - oldest;
+            if (grace > 0f) return $"Value drops in {Mathf.CeilToInt(grace)}s · oldest fish";
+            float freshness = haul.Min(f => State.Freshness(f, now));
+            return freshness <= GameData.MinFreshness ? "Oldest fish: 60% value · minimum" :
+                $"Oldest: {freshness * 100f:0}% value · loses 7%/min";
+        }
+
+        void DrawCastChoice()
+        {
+            if (!AwaitingCast || Manning == null) return;
+            var p = Panel(new Rect(VW / 2f - 230f, VH - 158f, 460f, 138f));
+            GUI.Label(new Rect(p.x + 16f, p.y + 12f, p.width - 32f, 28f), "Deckhand handles bait and carrying", Ui.Center);
+            var cast = new Rect(p.x + 16f, p.y + 52f, 296f, 68f);
+            var leave = new Rect(p.x + 324f, p.y + 52f, 120f, 68f);
+            Track(cast); Track(leave);
+            bool full = Cooler.Count >= State.CoolerCapacity;
+            if (GUI.Button(cast, full ? "Cooler full" : "Throw again", full ? Ui.BtnOff : Ui.Btn) && !full) ThrowAgain();
+            if (GUI.Button(leave, "Leave", Ui.BtnAlt)) LeaveFishing();
+        }
+    }
+}
